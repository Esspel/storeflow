# StoreFlow — required environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key — safe to expose in the browser
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER put the service role key here — it bypasses RLS and must stay server-side only
# SUPABASE_SERVICE_ROLE_KEY=  ← do not use in frontend

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Public VAPID key for browser push subscription (generate with: npx web-push generate-vapid-keys)
# The matching VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, and VAPID_SUBJECT must also be
# set as Supabase Edge Function secrets (supabase secrets set VAPID_PUBLIC_KEY=...)
# NOTE: The Edge Function (send-push) automatically strips the VITE_ prefix for
# backward compatibility, so VITE_VAPID_PUBLIC_KEY and VAPID_PUBLIC_KEY must match
# after prefix removal. All three Edge Function secrets are required.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ── Edge Function Secrets (set via: supabase secrets set <KEY>=<VALUE>) ───────
# These are required for push notifications to work. They must match the VITE_*
# client-side keys after prefix removal.
# VAPID_PUBLIC_KEY=your-vapid-public-key-here   (same as VITE_VAPID_PUBLIC_KEY)
# VAPID_PRIVATE_KEY=your-vapid-private-key-here
# VAPID_SUBJECT=mailto:admin@storeflow.app

# ── Auki Posemesh Integration ──────────────────────────────────────────────────
# Auki application credentials for posemesh network connection (AR overlay).
# Get these from your Auki dashboard under Applications.
VITE_AUKI_APP_KEY=your-auki-app-key-here
VITE_AUKI_APP_SECRET=your-auki-app-secret-here
