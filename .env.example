# StoreFlow — required environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key — safe to expose in the browser
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER put the service role key here — it bypasses RLS and must stay server-side only
# SUPABASE_SERVICE_ROLE_KEY=  ← do not use in frontend
