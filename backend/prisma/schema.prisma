// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====

enum UserRole {
  SUPERADMIN
  HQ
  REGIONAL_MANAGER
  STORE_MANAGER
  EMPLOYEE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ON_HOLD
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SCHEDULED
  CANCELLED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_OVERDUE
  INCIDENT_CREATED
  INCIDENT_RESOLVED
  AUDIT_SCHEDULED
  AUDIT_COMPLETED
  COMMENT_ADDED
  MESSAGE_RECEIVED
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

// ===== CORE ENTITIES =====

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  firstName         String
  lastName          String
  password          String
  phone             String?
  avatar            String?
  role              UserRole        @default(EMPLOYEE)
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId           String?
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  regionId          String?
  region            Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  
  isActive          Boolean         @default(true)
  emailVerified     Boolean         @default(false)
  lastLogin         DateTime?
  
  // Relations
  tasksAssigned     Task[]          @relation("assignedBy")
  tasksOwned        Task[]          @relation("assignee")
  incidentsReported Incident[]      @relation("reporter")
  incidentsAssigned Incident[]      @relation("assignedTo")
  auditResponses    AuditResponse[]
  comments          Comment[]
  messages          Message[]       @relation("sender")
  receivedMessages  Message[]       @relation("receiver")
  notifications     Notification[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([organizationId])
  @@index([storeId])
  @@index([regionId])
  @@index([role])
}

model Organization {
  id                String          @id @default(uuid())
  name              String          @unique
  slug              String          @unique
  description       String?
  logo              String?
  website           String?
  email             String?
  phone             String?
  
  // Address
  address           String?
  city              String?
  country           String?
  postalCode        String?
  
  isActive          Boolean         @default(true)
  
  // Relations
  users             User[]
  regions           Region[]
  stores            Store[]
  tasks             Task[]
  incidents         Incident[]
  audits            Audit[]
  auditTemplates    AuditTemplate[]
  notifications     Notification[]
  messages          Message[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([slug])
}

model Region {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name              String
  code              String
  description       String?
  managerId         String?
  manager           User?           @relation(fields: [managerId], references: [id], onDelete: SetNull)
  
  // Relations
  stores            Store[]
  tasks             Task[]
  incidents         Incident[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([managerId])
}

model Store {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regionId          String
  region            Region          @relation(fields: [regionId], references: [id], onDelete: Cascade)
  
  name              String
  code              String
  description       String?
  managerId         String?
  manager           User?           @relation(fields: [managerId], references: [id], onDelete: SetNull)
  
  // Address
  address           String
  city              String
  country           String
  postalCode        String
  phone             String?
  email             String?
  
  // Store info
  storeType         String?
  squareMeters      Int?
  openingHours      String?
  closingHours      String?
  
  isActive          Boolean         @default(true)
  
  // Relations
  users             User[]
  tasks             Task[]
  incidents         Incident[]
  audits            Audit[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([regionId])
  @@index([managerId])
}

// ===== TASK MANAGEMENT =====

model Task {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId           String?
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  regionId          String?
  region            Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  
  title             String
  description       String?
  status            TaskStatus      @default(PENDING)
  priority          TaskPriority    @default(MEDIUM)
  
  assigneeId        String?
  assignee          User?           @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User            @relation("assignedBy", fields: [createdById], references: [id], onDelete: Cascade)
  
  dueDate           DateTime?
  completedAt       DateTime?
  
  // Relations
  checklists        Checklist[]
  comments          Comment[]
  attachments       Attachment[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([organizationId])
  @@index([storeId])
  @@index([regionId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
}

model Checklist {
  id                String          @id @default(uuid())
  taskId            String
  task              Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  title             String
  description       String?
  order             Int             @default(0)
  
  // Relations
  items             ChecklistItem[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([taskId])
}

model ChecklistItem {
  id                String          @id @default(uuid())
  checklistId       String
  checklist         Checklist       @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  
  title             String
  description       String?
  completed         Boolean         @default(false)
  order             Int             @default(0)
  completedAt       DateTime?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([checklistId])
}

// ===== INCIDENT MANAGEMENT =====

model Incident {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storeId           String?
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  regionId          String?
  region            Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  
  title             String
  description       String?
  category          String?
  
  status            IncidentStatus  @default(OPEN)
  priority          IncidentPriority @default(MEDIUM)
  severity          IncidentSeverity @default(MEDIUM)
  
  reporterId        String
  reporter          User            @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assigneeId        String?
  assignee          User?           @relation("assignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  dueDate           DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  
  // SLA tracking
  slaBreached       Boolean         @default(false)
  
  // Relations
  comments          Comment[]
  attachments       Attachment[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([organizationId])
  @@index([storeId])
  @@index([regionId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

// ===== AUDITS =====

model AuditTemplate {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name              String
  description       String?
  category          String?
  maxScore          Int             @default(100)
  
  isActive          Boolean         @default(true)
  
  // Relations
  sections          AuditSection[]
  audits            Audit[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model AuditSection {
  id                String          @id @default(uuid())
  templateId        String
  template          AuditTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  title             String
  description       String?
  order             Int             @default(0)
  maxScore          Int             @default(100)
  
  // Relations
  questions         AuditQuestion[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([templateId])
}

model AuditQuestion {
  id                String          @id @default(uuid())
  sectionId         String
  section           AuditSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  
  question          String
  type              String          @default("text") // text, checkbox, rating, score
  order             Int             @default(0)
  maxScore          Int?
  required          Boolean         @default(true)
  
  // Relations
  responses         AuditQuestionResponse[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([sectionId])
}

model Audit {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId        String
  template          AuditTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  storeId           String?
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  
  title             String
  status            AuditStatus     @default(DRAFT)
  
  scheduledDate     DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  
  totalScore        Int?
  maxScore          Int?
  scorePercentage   Float?
  
  // Relations
  responses         AuditResponse[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId])
  @@index([templateId])
  @@index([storeId])
  @@index([status])
}

model AuditResponse {
  id                String          @id @default(uuid())
  auditId           String
  audit             Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  questionId        String
  question          AuditQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  response          String?
  score             Int?
  notes             String?
  
  // Relations
  attachments       Attachment[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([auditId, questionId])
  @@index([auditId])
  @@index([userId])
  @@index([questionId])
}

model AuditQuestionResponse {
  id                String          @id @default(uuid())
  questionId        String
  question          AuditQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  label             String
  value             String
  order             Int             @default(0)
  
  createdAt         DateTime        @default(now())

  @@index([questionId])
}

// ===== COMMENTS & COLLABORATION =====

model Comment {
  id                String          @id @default(uuid())
  taskId            String?
  task              Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  incidentId        String?
  incident          Incident?       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  authorId          String
  author            User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  content           String
  
  // Relations
  attachments       Attachment[]
  activityLogs      ActivityLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([taskId])
  @@index([incidentId])
  @@index([authorId])
}

model Attachment {
  id                String          @id @default(uuid())
  
  taskId            String?
  task              Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  incidentId        String?
  incident          Incident?       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  commentId         String?
  comment           Comment?        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  auditResponseId   String?
  auditResponse     AuditResponse?  @relation(fields: [auditResponseId], references: [id], onDelete: Cascade)
  
  fileName          String
  fileUrl           String
  fileSize          Int
  mimeType          String
  
  createdAt         DateTime        @default(now())

  @@index([taskId])
  @@index([incidentId])
  @@index([commentId])
  @@index([auditResponseId])
}

// ===== COMMUNICATIONS =====

model Message {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  senderId          String
  sender            User            @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId        String
  receiver          User            @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  
  subject           String?
  content           String
  read              Boolean         @default(false)
  readAt            DateTime?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([organizationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([read])
}

model Notification {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type              NotificationType @default(GENERAL)
  channel           NotificationChannel @default(IN_APP)
  
  title             String
  message           String
  link              String?
  data              String?         // JSON
  
  read              Boolean         @default(false)
  readAt            DateTime?
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([type])
  @@index([read])
}

// ===== ACTIVITY & AUDIT LOGS =====

model ActivityLog {
  id                String          @id @default(uuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  storeId           String?
  store             Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  regionId          String?
  region            Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  
  taskId            String?
  task              Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  incidentId        String?
  incident          Incident?       @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  auditId           String?
  audit             Audit?          @relation(fields: [auditId], references: [id], onDelete: SetNull)
  commentId         String?
  comment           Comment?        @relation(fields: [commentId], references: [id], onDelete: SetNull)
  
  action            String          // CREATE, UPDATE, DELETE, VIEW, COMMENT, etc.
  entityType        String          // Task, Incident, Audit, User, etc.
  entityId          String?
  
  oldValue          String?         // JSON - previous state
  newValue          String?         // JSON - new state
  
  description       String?
  ipAddress         String?
  userAgent         String?
  
  createdAt         DateTime        @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([storeId])
  @@index([regionId])
  @@index([taskId])
  @@index([incidentId])
  @@index([auditId])
  @@index([action])
  @@index([entityType])
}

// ===== SESSION MANAGEMENT =====

model RefreshToken {
  id                String          @id @default(uuid())
  userId            String
  token             String          @unique
  expiresAt         DateTime
  revoked           Boolean         @default(false)
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([expiresAt])
}
